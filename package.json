{
  "name": "techcontrol-itern",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --import ./tests/offline-guard.mjs node_modules/vitest/vitest.mjs run src/domain.test.ts && node --import ./tests/offline-guard.mjs --test tests/local-api.test.mjs tests/supervision.test.mjs",
    "start": "node --env-file-if-exists=.env.local server/index.mjs",
    "start:open": "node --env-file-if-exists=.env.local scripts/start.mjs",
    "dev:api": "node --env-file-if-exists=.env.local --watch server/index.mjs --dev",
    "test:api": "node --import ./tests/offline-guard.mjs --test tests/local-api.test.mjs",
    "test:supervision": "node --import ./tests/offline-guard.mjs --test tests/supervision.test.mjs",
    "configure:lan": "node scripts/configure-lan.mjs"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.13",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "lucide-react": "^0.468.0",
    "node-forge": "^1.4.2",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-router-dom": "^7.9.1",
    "recharts": "^3.2.1",
    "tailwindcss": "^4.1.13",
    "ws": "^8.22.0",
    "zod": "^4.1.11"
  },
  "devDependencies": {
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@vitejs/plugin-react": "^5.0.3",
    "typescript": "~5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=24.0.0"
  }
}
